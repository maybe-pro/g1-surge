#!name=Google One 探针（只在日志里报数据，不改价格）
#!desc=把 one.google.com 返回的计划 ID 与货币上报，用于排查某台设备/账号拉不到折扣的原因
#!system=ios

[MITM]
hostname = %APPEND% one.google.com

[Script]
Google One 探针 = type=http-response,pattern=one\.google\.com,requires-body=1,max-size=4194304,script-path=https://cdn.jsdelivr.net/gh/maybe-pro/g1-surge@main/g1-ios-tr-probe.js
